{
  "model_name": "Qwen/Qwen2.5-Math-1.5B",
  "max_seq_length": 2048,
  "dtype": "bfloat16",
  "load_in_4bit": false,
  "lora_r": 16,
  "lora_alpha": 16,
  "lora_dropout": 0.0,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "use_gradient_checkpointing": "unsloth",
  "train_jsonl": "data/sft_data_v2.jsonl",
  "eval_fraction": 0.05,
  "task_mode": "counterexample_only",
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 2.0,
  "max_steps": -1,
  "learning_rate": 0.0002,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "optim": "adamw_torch",
  "weight_decay": 0.0,
  "max_grad_norm": 1.0,
  "seed": 42,
  "eval_strategy": "steps",
  "eval_steps": 200,
  "logging_steps": 50,
  "save_strategy": "steps",
  "save_steps": 200,
  "save_total_limit": 2,
  "output_dir": "checkpoints/sft/qwen25-math-1_5b-r16-bf16-v2-smoke",
  "use_run_dir": true,
  "report_to": "wandb",
  "wandb_project": "",
  "wandb_group": "",
  "holdout_probe_enabled": true,
  "holdout_probe_jsonl": "data/test_set_v2.jsonl",
  "holdout_probe_n_prompts": 50,
  "holdout_probe_k_samples": 8,
  "holdout_probe_temperature": 1.0,
  "holdout_probe_max_new_tokens": 512
}